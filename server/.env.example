# 服务端环境变量（复制为 .env，.env 不提交）
APP_ENV=development
DEBUG=1
HOST=0.0.0.0
PORT=5000
TRUST_PROXY=0
SECRET_KEY=replace-with-a-long-random-flask-secret

# MySQL：只给 API 服务访问，不对公网开放 3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=renovation
DB_USER=renovation_app
DB_PASSWORD=change-me
DB_TIMEZONE=+08:00
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=10
DB_WRITE_TIMEOUT=10

# 管理员与用户令牌完全隔离；生成：openssl rand -hex 32
JWT_ADMIN_SECRET=
JWT_USER_SECRET=
JWT_ISSUER=renovation-api
ADMIN_ACCESS_TTL=15m
USER_ACCESS_TTL=30m
REFRESH_TTL=7d

# 密码 / MFA
BCRYPT_ROUNDS=12
ADMIN_MAX_FAILED_LOGIN=5
ADMIN_LOCK_MINUTES=15
ADMIN_MFA_REQUIRED=true
# TOTP 密钥加密；必须 64 位 hex：openssl rand -hex 32
MFA_SECRET_KEY=

# 限流
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_RATE_MAX=5
API_RATE_WINDOW_SECONDS=60
API_RATE_MAX=120

# 微信小程序（Secret 只能放服务端，绝不能进小程序包）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 仅开发/演示允许 code=demo 直接登录；生产必须 false
ALLOW_DEMO_LOGIN=true

# 导出激励视频：演示模式允许 adProof=demo；生产必须由广告平台服务端回调签发
EXPORT_UNLOCK_MODE=demo
EXPORT_UNLOCK_SECRET=
EXPORT_TOKEN_TTL=600

# 广告位；真正接入广告平台后再填
AD_ENABLED=false
AD_SLOT_HOME=
AD_SLOT_STATS=
AD_SLOT_EXPORT=

# 上传目录与大小限制
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# 允许跨域的 Web 调试来源，逗号分隔；小程序不受浏览器 CORS 保护
CORS_ORIGINS=
