# 服务端环境变量（复制为 .env 后填写，.env 不提交）
NODE_ENV=development
PORT=3000
TRUST_PROXY=0

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=renovation
DB_USER=renovation_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=root-change-me
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=+08:00

# 令牌：管理员与普通用户使用不同密钥、不同 audience，防止令牌串用
JWT_ADMIN_SECRET=replace-with-a-long-random-admin-secret
JWT_USER_SECRET=replace-with-a-long-random-user-secret
JWT_ISSUER=renovation-api
ADMIN_ACCESS_TTL=15m
USER_ACCESS_TTL=30m
REFRESH_TTL=7d

# 登录与接口限流
LOGIN_RATE_WINDOW_MS=60000
LOGIN_RATE_MAX=5
API_RATE_WINDOW_MS=60000
API_RATE_MAX=120
BCRYPT_ROUNDS=12
ADMIN_MAX_FAILED_LOGIN=5
ADMIN_LOCK_MINUTES=15
ADMIN_MFA_REQUIRED=true
# 用于加密管理员 TOTP 密钥；生成：openssl rand -hex 32
MFA_SECRET_KEY=

# 微信小程序（Secret 只能放服务端，绝不能进小程序包）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 允许跨域的 Web 调试来源，逗号分隔；小程序本身不受浏览器 CORS 保护
CORS_ORIGINS=
