.detail-hero { background: #155EEF; border-radius: 26rpx; padding: 30rpx; color: #FFFFFF; }
.eyebrow { font-size: 18rpx; letter-spacing: 3rpx; font-weight: 700; }
.detail-title { font-size: 40rpx; font-weight: 700; margin-top: 10rpx; line-height: 1.3; }
.detail-sub { font-size: 22rpx; color: rgba(255,255,255,0.7); margin-top: 8rpx; }
.detail-numbers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-top: 28rpx; }
.tiny.light { color: rgba(255,255,255,0.65); }
.detail-num { font-size: 30rpx; font-weight: 700; margin-top: 4rpx; }
.seq { width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%; background: #EAF0FF; color: #155EEF; font-size: 18rpx; font-weight: 700; text-align: center; margin-right: 14rpx; flex: none; }
.payment-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #EEF2F9; }
.payment-row:last-child { border-bottom: none; }
.payment-title { font-size: 26rpx; font-weight: 600; }
.pay-btn { margin-left: 10rpx; }
.security-note { margin-top: 24rpx; padding: 20rpx 24rpx; background: #EAF0FF; border-radius: 16rpx; }
