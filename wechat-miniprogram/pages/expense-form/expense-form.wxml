<view class="page page-safe">
  <view class="eyebrow">NEW EXPENSE</view>
  <view class="title">记一笔</view>
  <view class="muted">金额、分类、付款方式与凭证，都会进入预算和统计。</view>

  <view class="amount-box">
    <view class="tiny">支出金额</view>
    <view class="amount-input-row">
      <text class="currency">¥</text>
      <input class="amount-input" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmount" focus />
    </view>
  </view>

  <view class="form-card">
    <view class="field">
      <view class="field-label">分类</view>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory">
        <view class="picker between"><text>{{categories[categoryIndex]}}</text><text class="chev">›</text></view>
      </picker>
    </view>

    <view class="field">
      <view class="field-label">付款方式</view>
      <picker mode="selector" range="{{payTypes}}" value="{{payIndex}}" bindchange="onPayType">
        <view class="picker between"><text>{{payTypes[payIndex]}}</text><text class="chev">›</text></view>
      </picker>
    </view>

    <view class="field">
      <view class="field-label">日期</view>
      <picker mode="date" value="{{date}}" start="2020-01-01" end="2026-12-31" bindchange="onDate">
        <view class="picker between"><text>{{date}}</text><text class="chev">›</text></view>
      </picker>
    </view>

    <view class="field">
      <view class="field-label">凭证（最多 3 张）</view>
      <view class="voucher-row">
        <view class="voucher" wx:for="{{vouchers}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" />
        </view>
        <view class="voucher add" wx:if="{{vouchers.length !== 3}}" bindtap="chooseVoucher">+</view>
      </view>
      <view class="tiny">演示模式只记录本地路径；服务端模式会上传到上传接口。</view>
    </view>

    <view class="field">
      <view class="field-label">备注</view>
      <textarea class="textarea" placeholder="例如：客厅射灯补货、合同第 4 期" value="{{note}}" bindinput="onNote" maxlength="120"></textarea>
    </view>
  </view>

  <button class="btn btn-block submit" bindtap="submit" loading="{{loading}}">保存这笔支出</button>
</view>
