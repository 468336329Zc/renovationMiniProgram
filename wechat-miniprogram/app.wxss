page {
  background: #F2F6FC;
  color: #0B1B33;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}
.page { padding: 24rpx 28rpx 48rpx; box-sizing: border-box; }
.page-safe { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(18, 43, 89, 0.06);
  box-sizing: border-box;
}
.hero {
  background: #155EEF;
  border-radius: 28rpx;
  padding: 32rpx;
  color: #FFFFFF;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.hero::after {
  content: "";
  position: absolute;
  right: -80rpx;
  top: -100rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.10);
}
.hero-label { font-size: 22rpx; color: rgba(255,255,255,0.72); letter-spacing: 1rpx; }
.hero-value { font-size: 58rpx; font-weight: 700; line-height: 1.2; margin-top: 10rpx; letter-spacing: -1rpx; }
.hero-value .unit { font-size: 24rpx; font-weight: 400; margin-left: 6rpx; opacity: 0.8; }
.hero-meta { display: flex; justify-content: space-between; margin-top: 24rpx; font-size: 22rpx; color: rgba(255,255,255,0.78); }
.title { font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.25; }
.title-sm { font-size: 32rpx; font-weight: 700; line-height: 1.3; }
.muted { color: #7A869A; font-size: 24rpx; line-height: 1.5; }
.tiny { color: #9AA6BB; font-size: 20rpx; }
.section-head { display: flex; justify-content: space-between; align-items: flex-end; margin: 36rpx 2rpx 16rpx; }
.section-head .link { color: #155EEF; font-size: 24rpx; font-weight: 600; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.flex1 { flex: 1; min-width: 0; }
.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; }
.pill {
  display: inline-flex; align-items: center; height: 40rpx; padding: 0 14rpx;
  border-radius: 999rpx; font-size: 20rpx; font-weight: 600;
}
.pill-blue { color: #155EEF; background: #EAF0FF; }
.pill-green { color: #12805C; background: #E8F7F1; }
.pill-orange { color: #B45309; background: #FFF3E4; }
.pill-red { color: #C81E1E; background: #FDECEC; }
.pill-gray { color: #7A869A; background: #F0F3F8; }
.btn {
  height: 88rpx; border-radius: 18rpx; background: #155EEF; color: #FFFFFF;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 600; border: none;
}
.btn::after { border: none; }
.btn-ghost { background: #FFFFFF; color: #155EEF; border: 2rpx solid #D6E2FA; }
.btn-soft { background: #EAF0FF; color: #155EEF; }
.btn-block { width: 100%; }
.btn-sm { height: 64rpx; font-size: 24rpx; border-radius: 14rpx; padding: 0 24rpx; }
.chips { display: flex; gap: 12rpx; overflow-x: auto; padding: 6rpx 0 10rpx; white-space: nowrap; }
.chip {
  flex: none; height: 60rpx; padding: 0 24rpx; border-radius: 999rpx;
  background: #FFFFFF; color: #7A869A; font-size: 24rpx;
  display: flex; align-items: center; border: 2rpx solid #E6ECF7;
}
.chip.on { background: #155EEF; color: #FFFFFF; border-color: #155EEF; }
.bar { height: 12rpx; border-radius: 999rpx; background: #EAF0FA; overflow: hidden; }
.bar > view { height: 12rpx; border-radius: 999rpx; background: #155EEF; }
.bar.orange > view { background: #E67E22; }
.list-item { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #EEF2F9; }
.list-item:last-child { border-bottom: none; }
.icon-square {
  width: 64rpx; height: 64rpx; border-radius: 16rpx; background: #EAF0FF;
  display: flex; align-items: center; justify-content: center;
  color: #155EEF; font-size: 24rpx; font-weight: 700;
}
.field { margin-bottom: 22rpx; }
.field-label { font-size: 24rpx; color: #52627C; margin-bottom: 10rpx; }
.input, .picker {
  height: 84rpx; background: #F7F9FE; border: 2rpx solid #E6ECF7;
  border-radius: 16rpx; padding: 0 22rpx; font-size: 26rpx;
  display: flex; align-items: center; box-sizing: border-box;
}
.textarea {
  min-height: 160rpx; background: #F7F9FE; border: 2rpx solid #E6ECF7;
  border-radius: 16rpx; padding: 20rpx 22rpx; font-size: 26rpx; box-sizing: border-box;
}
.ad-slot {
  display: flex; align-items: center; gap: 16rpx;
  background: #FFFFFF; border: 2rpx dashed #D6E2FA; border-radius: 18rpx;
  padding: 18rpx 22rpx; margin-top: 24rpx;
}
.ad-slot .ad-tag { font-size: 18rpx; color: #9AA6BB; border: 1rpx solid #C9D6EE; border-radius: 6rpx; padding: 2rpx 8rpx; }
.ad-slot .ad-copy { flex: 1; font-size: 22rpx; color: #7A869A; line-height: 1.4; }
.empty { padding: 60rpx 0; text-align: center; color: #9AA6BB; font-size: 24rpx; }
.timeline { position: relative; padding-left: 46rpx; }
.timeline::before {
  content: ""; position: absolute; left: 15rpx; top: 10rpx; bottom: 10rpx; width: 2rpx; background: #DCE6F7;
}
.tl-node { position: relative; padding: 0 0 26rpx; }
.tl-dot {
  position: absolute; left: -38rpx; top: 8rpx; width: 18rpx; height: 18rpx;
  border-radius: 50%; background: #C9D6EE; border: 4rpx solid #FFFFFF;
}
.tl-dot.done { background: #155EEF; }
.tl-dot.now { background: #E67E22; }
.tl-card { background: #FFFFFF; border-radius: 18rpx; padding: 22rpx; }
